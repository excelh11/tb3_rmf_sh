<?xml version='1.0' ?>

<!-- Starts Gazebo with a world generated by tb3_rmf_sh_maps.
     Model and plugin paths are set explicitly so the world loads even if
     the environment hooks were not sourced in this terminal. -->
<launch>
  <arg name="map_package" default="tb3_rmf_sh_maps" description="Package that holds the generated world"/>
  <arg name="map_name" default="sh_delivery" description="Name of the building (maps/NAME/NAME.world)"/>
  <arg name="gazebo_version" default="8"/>
  <arg name="headless" default="false" description="true: run Gazebo without GUI"/>

  <let name="world_path" value="$(find-pkg-share $(var map_package))/maps/$(var map_name)/$(var map_name).world"/>
  <!-- generated floors : RMF robot/workcell models : models downloaded at build time (Fuel) : existing path -->
  <let name="model_path" value="$(find-pkg-share $(var map_package))/maps/$(var map_name)/models:$(find-pkg-share rmf_demos_assets)/models:$(env HOME)/.gazebo/models:$(env GZ_SIM_RESOURCE_PATH '')"/>
  <!-- slotcar, lift, door, dispenser/ingestor plugins -->
  <let name="plugin_path" value="$(find-pkg-prefix rmf_robot_sim_gz_plugins)/lib/rmf_robot_sim_gz_plugins:$(find-pkg-prefix rmf_building_sim_gz_plugins)/lib/rmf_building_sim_gz_plugins:$(env GZ_SIM_SYSTEM_PLUGIN_PATH '')"/>
  <let name="gui_plugin_path" value="$(find-pkg-prefix rmf_robot_sim_gz_plugins)/lib/rmf_robot_sim_gz_plugins:$(find-pkg-prefix rmf_building_sim_gz_plugins)/lib/rmf_building_sim_gz_plugins:$(env GZ_GUI_PLUGIN_PATH '')"/>

  <let name="gz_headless" if="$(var headless)" value="-s"/>
  <let name="gz_headless" unless="$(var headless)" value=""/>

  <executable cmd="gz sim --force-version $(var gazebo_version) $(var gz_headless) -r -v 3 $(var world_path)" output="both">
    <env name="GZ_SIM_RESOURCE_PATH" value="$(var model_path)"/>
    <env name="GZ_SIM_SYSTEM_PLUGIN_PATH" value="$(var plugin_path)"/>
    <env name="GZ_GUI_PLUGIN_PATH" value="$(var gui_plugin_path)"/>
  </executable>

  <!-- Gazebo clock -> ROS /clock (use_sim_time) -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge"
        args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock"/>
</launch>
